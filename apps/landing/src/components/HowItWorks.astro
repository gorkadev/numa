---
import { CheckmarkCircle02Icon, Loading03Icon, PlayIcon } from "@hugeicons/core-free-icons"

import { t, type Locale } from "../i18n"
import Icon from "./Icon.astro"
import SectionHeader from "./SectionHeader.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale)
const { demo } = copy.how
const activity = [demo.plan, demo.code, demo.scene]
---

<section id="how-it-works" class="scroll-mt-24 px-4 py-20 md:py-24" aria-labelledby="how-title">
  <div class="mx-auto max-w-6xl">
    <SectionHeader id="how-title" eyebrow={copy.how.eyebrow} title={copy.how.title} />

    <ol class="mt-16 grid gap-4 md:grid-cols-3">
      {
        copy.how.steps.map((step, index) => (
          <li
            class="flex flex-col rounded-3xl bg-surface p-2"
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <!-- Each step shows a small, honest picture of that moment in the app. -->
            <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-card p-6" aria-hidden="true">
              {index === 0 && (
                <div class="w-full rounded-xl bg-surface p-3 shadow-sm">
                  <p class="text-foreground body-6">
                    {demo.prompt}
                    <span class="caret ml-0.5 inline-block h-4 w-px translate-y-0.5 bg-primary" />
                  </p>
                  <div class="mt-6 flex justify-end">
                    <span class="rounded-lg bg-primary px-3 py-1 text-primary-foreground caption-3">
                      {demo.send}
                    </span>
                  </div>
                </div>
              )}
              {index === 1 && (
                <ul class="flex w-full flex-col gap-3">
                  {activity.map((label) => (
                    <li class="flex items-center gap-3 text-foreground body-6">
                      <Icon icon={CheckmarkCircle02Icon} size={20} class="shrink-0 text-emerald-500" />
                      {label}
                    </li>
                  ))}
                  <li class="flex items-center gap-3 text-muted-foreground body-6">
                    <Icon icon={Loading03Icon} size={20} class="spin shrink-0 text-primary" />
                    {demo.verify}
                  </li>
                </ul>
              )}
              {index === 2 && (
                <>
                  <img
                    src="/island.webp"
                    alt=""
                    width="960"
                    height="720"
                    loading="lazy"
                    class="absolute inset-0 size-full object-cover"
                  />
                  <span class="relative inline-flex items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-neutral-950 button-sm shadow-lg backdrop-blur-md">
                    <Icon icon={PlayIcon} size={16} />
                    {demo.play}
                  </span>
                </>
              )}
            </div>
            <div class="flex flex-col gap-2 p-4 pt-6">
              <span class="text-muted-foreground caption-3">0{index + 1}</span>
              <h3 class="heading-6">{step.title}</h3>
              <p class="text-muted-foreground body-3">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .caret {
    animation: blink 1.1s steps(1) infinite;
  }
  .spin {
    animation: spin 1.2s var(--ease-out-quint) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret,
    .spin {
      animation: none;
    }
  }
</style>
