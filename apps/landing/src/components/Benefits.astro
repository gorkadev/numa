---
import { AtIcon, Coins01Icon, CodeIcon, PackageIcon } from "@hugeicons/core-free-icons"

import { t, type Locale } from "../i18n"
import Icon from "./Icon.astro"
import SectionHeader from "./SectionHeader.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale)
const icons = [CodeIcon, PackageIcon, AtIcon, Coins01Icon]
---

<section class="px-4 py-20 md:py-24" aria-labelledby="benefits-title">
  <div class="mx-auto max-w-6xl">
    <SectionHeader id="benefits-title" eyebrow={copy.benefits.eyebrow} title={copy.benefits.title} />

    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        copy.benefits.items.map((item, index) => (
          <li
            class="flex flex-col gap-4 rounded-3xl bg-surface p-6"
            data-reveal
            style={`--reveal-delay: ${index * 80}ms`}
          >
            <span class="grid size-10 place-items-center rounded-xl bg-card text-primary shadow-sm">
              <Icon icon={icons[index]!} size={20} />
            </span>
            <h3 class="heading-6">{item.title}</h3>
            <p class="text-muted-foreground body-3">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
