---
import { Cancel01Icon, Menu01Icon } from "@hugeicons/core-free-icons"

import { homePath, signInUrl, t, type Locale } from "../i18n"
import Icon from "./Icon.astro"
import { LinkButton } from "./LinkButton"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale)

const links = [
  { href: "#how-it-works", label: copy.nav.howItWorks },
  { href: "#templates", label: copy.nav.templates },
  { href: "#pricing", label: copy.nav.pricing },
  { href: "#faq", label: copy.nav.faq },
]
---

<!--
  A minimal bar: links on the left, the mark in the middle, the call to action
  on the right. Over the hero it is fully transparent and dark, so nothing
  covers the island; past the hero it picks up a blurred surface in the page's
  own theme. The page script toggles `data-over-hero` and marks the link for
  the section in view as current.
-->
<header class="site-nav fixed inset-x-0 top-0 z-40 transition-[background-color,box-shadow] duration-300 ease-out-quint" data-nav data-over-hero>
  <nav aria-label="Main" class="mx-auto grid h-16 max-w-7xl grid-cols-[1fr_auto_1fr] items-center px-6 sm:px-10">
    <ul class="hidden items-center gap-6 md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="nav-link title-4" data-nav-link>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button
      type="button"
      class="nav-fg relative -ml-2 grid size-9 place-items-center rounded-lg md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
      data-open-label={copy.nav.openMenu}
      data-close-label={copy.nav.closeMenu}
    >
      <span class="sr-only" data-menu-label>{copy.nav.openMenu}</span>
      <Icon icon={Menu01Icon} size={20} class="menu-icon absolute transition-[transform,opacity] duration-300 ease-out-quint" />
      <Icon
        icon={Cancel01Icon}
        size={20}
        class="close-icon absolute scale-50 rotate-[-90deg] opacity-0 transition-[transform,opacity] duration-300 ease-out-quint"
      />
    </button>

    <a href={homePath(locale)} class="nav-fg flex items-center gap-2" aria-label={copy.nav.home}>
      <img src="/logo.svg" alt="" width="20" height="24" class="size-6" />
      <span class="title-1">numa</span>
    </a>

    <div class="flex items-center justify-end gap-4">
      <a href={signInUrl} class="nav-link hidden button-sm sm:inline-flex">{copy.nav.signIn}</a>
      <LinkButton href={signInUrl} size="lg">{copy.nav.start}</LinkButton>
    </div>
  </nav>
</header>

<!--
  The mobile menu is a full height panel, not a dropdown. Links arrive one
  after another, 60ms apart, well under 400ms in total.
-->
<div
  id="mobile-menu"
  class="fixed inset-0 z-30 flex flex-col bg-background/95 px-6 pt-24 opacity-0 backdrop-blur-2xl transition-opacity duration-300 ease-out-quint [&:not([data-open])]:pointer-events-none data-open:opacity-100 md:hidden"
  data-mobile-menu
  inert
>
  <ul class="flex flex-col gap-1">
    {
      links.map((link, index) => (
        <li
          class="translate-y-6 opacity-0 transition-[transform,opacity] duration-500 ease-out-quint [[data-open]_&]:translate-y-0 [[data-open]_&]:opacity-100"
          style={`transition-delay: ${index * 60}ms`}
        >
          <a href={link.href} class="block rounded-lg py-3 heading-5" data-menu-link>
            {link.label}
          </a>
        </li>
      ))
    }
    <li
      class="translate-y-6 opacity-0 transition-[transform,opacity] duration-500 ease-out-quint [[data-open]_&]:translate-y-0 [[data-open]_&]:opacity-100"
      style={`transition-delay: ${links.length * 60}ms`}
    >
      <a href={signInUrl} class="block rounded-lg py-3 text-muted-foreground heading-5">
        {copy.nav.signIn}
      </a>
    </li>
  </ul>
</div>

<style>
  .site-nav {
    --nav-fg: var(--foreground);
    --nav-muted: var(--muted-foreground);
    background-color: color-mix(in oklch, var(--background) 75%, transparent);
    backdrop-filter: blur(20px);
    box-shadow: 0 1px 0 var(--border);
  }

  /* Over the sky the bar disappears and its type turns dark. */
  .site-nav[data-over-hero] {
    --nav-fg: #050816;
    --nav-muted: rgb(5 8 22 / 0.72);
    background-color: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }

  /* While the mobile menu is open the bar sits on the page's own surface. */
  .site-nav:has([aria-expanded="true"]) {
    --nav-fg: var(--foreground);
  }

  .nav-fg {
    color: var(--nav-fg);
  }

  .nav-link {
    color: var(--nav-muted);
    transition: color 300ms var(--ease-out-quint);
  }
  .nav-link:hover,
  .nav-link[aria-current="true"] {
    color: var(--nav-fg);
  }


  [data-menu-toggle][aria-expanded="true"] :global(.menu-icon) {
    opacity: 0;
    transform: scale(0.5) rotate(90deg);
  }
  [data-menu-toggle][aria-expanded="true"] :global(.close-icon) {
    opacity: 1;
    transform: none;
  }
</style>
