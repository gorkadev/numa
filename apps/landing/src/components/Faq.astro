---
import { PlusSignIcon } from "@hugeicons/core-free-icons"

import { t, type Locale } from "../i18n"
import Icon from "./Icon.astro"
import SectionHeader from "./SectionHeader.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale)

/* FAQ structured data, so answer engines can quote the answers (skill A7). */
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: copy.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
}
---

<section id="faq" class="scroll-mt-24 px-4 py-20 md:py-24" aria-labelledby="faq-title">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.6fr]">
    <SectionHeader id="faq-title" eyebrow={copy.faq.eyebrow} title={copy.faq.title} align="start" />

    <div class="flex flex-col gap-2" data-reveal>
      {
        copy.faq.items.map((item) => (
          <details class="faq group rounded-2xl bg-surface">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6 title-2">
              {item.q}
              <Icon
                icon={PlusSignIcon}
                size={20}
                class="shrink-0 text-muted-foreground transition-transform duration-300 ease-out-quint group-open:rotate-45"
              />
            </summary>
            <p class="px-6 pb-6 text-muted-foreground body-3">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
