---
import { ArrowRight01Icon, PlayIcon } from "@hugeicons/core-free-icons"

import { signInUrl, t, type Locale } from "../i18n"
import Icon from "./Icon.astro"
import { LinkButton } from "./LinkButton"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale)
---

<!--
  A minimal hero: the island owns the stage and nothing sits on top of it.
  The copy is a short column on the left, the facts sit along the bottom, and
  the island floats in the open sky on the right (lower down on narrow
  screens). The section is a tall track with a pinned stage: scrolling through
  the extra height dives the camera towards the island as the copy eases away.
  The CSS sky is the whole picture when WebGL, the network or motion are not
  available.
-->
<section class="relative h-[160svh]" aria-labelledby="hero-title" data-hero>
  <div class="sticky top-0 h-svh min-h-[36rem] overflow-hidden">
    <div class="hero-sky absolute inset-0" aria-hidden="true"></div>
    <div
      class="absolute inset-0 opacity-0 transition-opacity duration-1000 ease-out-quint data-ready:opacity-100"
      role="img"
      aria-label={copy.hero.sceneLabel}
      data-island
    >
    </div>
    <div class="hero-fade pointer-events-none absolute inset-x-0 bottom-0 h-6" aria-hidden="true"></div>

    <div class="scene-light relative mx-auto flex h-full max-w-7xl flex-col px-6 pt-28 pb-10 sm:px-10 lg:justify-center lg:pt-0" data-hero-copy>
      <div class="max-w-xl">
        <p class="inline-flex rounded-full bg-white/40 px-3 py-1 text-neutral-800 caption-4 backdrop-blur-md">
          {copy.hero.badge}
        </p>
        <h1 id="hero-title" class="hero-title mt-6 heading-3 sm:heading-2 lg:heading-1">
          <span class="block">{copy.hero.title[0]}</span>
          <span class="block">{copy.hero.title[1]}</span>
        </h1>
        <p class="mt-6 max-w-md text-neutral-800 body-3 sm:title-2 sm:font-normal">
          {copy.hero.subtitle}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-2">
          <LinkButton href={signInUrl} size="lg">
            {copy.hero.primary}
            <Icon icon={ArrowRight01Icon} size={16} data-icon="inline-end" />
          </LinkButton>
          <LinkButton href="#how-it-works" variant="secondary" size="lg">
            {copy.hero.secondary}
            <Icon icon={PlayIcon} size={16} data-icon="inline-end" />
          </LinkButton>
        </div>
      </div>

      <dl class="mt-auto hidden gap-8 sm:flex lg:absolute lg:bottom-10 lg:left-10">
        {
          copy.hero.stats.map((stat, index) => (
            <div class:list={["flex flex-col-reverse gap-1", index > 0 && "border-l border-neutral-950/15 pl-8"]}>
              <dt class="text-neutral-700 caption-2">{stat.label}</dt>
              <dd class="text-neutral-950 heading-5">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Matches the shader dome in island-scene.ts, so the swap is invisible. */
  .hero-sky {
    background:
      radial-gradient(120% 70% at 50% 110%, #ffdcb8 0%, transparent 60%),
      linear-gradient(to bottom, #4f9bff 0%, #a9d0ff 55%, #cfe2ff 100%);
  }

  /* Hands the sky over to the page below without a hard edge. */
  .hero-fade {
    background: linear-gradient(to bottom, transparent, var(--background));
  }

  /* The skill's heading gradient (B5), kept dark so it reads on a bright sky. */
  .hero-title {
    background-image: linear-gradient(to right, #050816, #34456b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
