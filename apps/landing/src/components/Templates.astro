---
import { t, type Locale } from "../i18n"
import SectionHeader from "./SectionHeader.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale)
---

<section id="templates" class="scroll-mt-24 px-4 py-20 md:py-24" aria-labelledby="templates-title">
  <div class="mx-auto max-w-6xl">
    <SectionHeader
      id="templates-title"
      eyebrow={copy.templates.eyebrow}
      title={copy.templates.title}
      subtitle={copy.templates.subtitle}
    />

    <ul class="mt-16 grid gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        copy.templates.items.map((item, index) => (
          <li class="group" data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`}>
            <div class="overflow-hidden rounded-2xl bg-surface">
              <img
                src={`/templates/${item.id}.webp`}
                alt={item.tagline}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
                class="aspect-video w-full object-cover transition-transform duration-500 ease-out-quint group-hover:scale-[1.03]"
              />
            </div>
            <div class="mt-4 flex items-center gap-2">
              <h3 class="title-2">{item.name}</h3>
              <span class="rounded-md bg-muted px-2 py-0.5 text-muted-foreground caption-3">{item.kind}</span>
            </div>
            <p class="mt-1 text-muted-foreground body-6">{item.tagline}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
