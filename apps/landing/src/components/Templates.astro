---
import { Badge } from "@workspace/ui/components/badge"
import { Card, CardDescription, CardHeader, CardTitle } from "@workspace/ui/components/card"

import { t, type Locale } from "../i18n"
import SectionHeader from "./SectionHeader.astro"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale)
---

<section id="templates" class="scroll-mt-24 px-4 py-20 md:py-24" aria-labelledby="templates-title">
  <div class="mx-auto max-w-6xl">
    <SectionHeader
      id="templates-title"
      eyebrow={copy.templates.eyebrow}
      title={copy.templates.title}
      subtitle={copy.templates.subtitle}
    />

    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        copy.templates.items.map((item, index) => (
          <li data-reveal style={`--reveal-delay: ${(index % 3) * 80}ms`}>
            <Card className="h-full">
              <img
                src={`/templates/${item.id}.webp`}
                alt={item.tagline}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
                class="aspect-video w-full object-cover"
              />
              <CardHeader>
                <CardTitle className="flex items-center gap-2">
                  <h3>{item.name}</h3>
                  <Badge variant="secondary">{item.kind}</Badge>
                </CardTitle>
                <CardDescription>{item.tagline}</CardDescription>
              </CardHeader>
            </Card>
          </li>
        ))
      }
    </ul>
  </div>
</section>
