---
import { signInUrl, t, type Locale } from "../i18n"
import { PricingSection } from "./pricing-section"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = t(locale)
---

<!--
  Prices and allowances come from the app's plans (`lib/polar/products.ts`).
  The layout is the @efferd/pricing-3 block, rendered at build time.
-->
<div data-reveal>
  <PricingSection copy={copy.pricing} signInUrl={signInUrl} />
</div>
