---
import { ArrowUp02Icon } from "@hugeicons/core-free-icons"

import { signInUrl, t, type Locale } from "../i18n"
import Icon from "./Icon.astro"

interface Props {
  locale: Locale
  id: string
  /** Show the example prompts under the box. */
  suggestions?: boolean
}

const { locale, id, suggestions = true } = Astro.props
const copy = t(locale)
const errorId = `${id}-error`
---

<!--
  A demo of the app's composer. It is a plain GET form to the app's sign-in,
  carrying the prompt as `?prompt=`, so it works with no JavaScript at all.
  The app does not read that parameter yet; once it does, a visitor lands
  with their game already being built.
-->
<form
  action={signInUrl}
  method="get"
  class="composer w-full"
  novalidate
  data-composer
>
  <div
    class="group/composer rounded-2xl border border-white/70 bg-white/85 p-2 shadow-[0_24px_64px_-24px_rgb(15_23_42/0.45)] backdrop-blur-xl transition-[box-shadow,border-color] duration-300 ease-out-quint focus-within:border-white focus-within:shadow-[0_32px_80px_-24px_rgb(15_23_42/0.55)]"
  >
    <label for={`${id}-prompt`} class="sr-only">{copy.composer.label}</label>
    <textarea
      id={`${id}-prompt`}
      name="prompt"
      rows="2"
      required
      maxlength="2000"
      aria-describedby={errorId}
      placeholder={copy.composer.placeholder}
      class="block max-h-48 min-h-16 w-full resize-none bg-transparent px-3 pt-2 text-neutral-950 body-3 placeholder:text-neutral-500 focus:outline-none"
    ></textarea>
    <div class="flex items-center justify-between gap-3 pt-2">
      <p id={errorId} class="pl-3 text-red-600 caption-2" aria-live="polite" data-composer-error hidden>
        {copy.composer.empty}
      </p>
      <button
        type="submit"
        class="ml-auto inline-flex items-center gap-2 rounded-lg bg-primary px-3 py-2 text-primary-foreground button-sm shadow-sm transition-[transform,background-color] duration-300 ease-out-quint hover:bg-primary/90 active:scale-[0.98]"
      >
        {copy.composer.submit}
        <Icon icon={ArrowUp02Icon} size={16} class="rotate-45" />
      </button>
    </div>
  </div>

  {
    suggestions && (
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        <span class="text-neutral-700 caption-4">{copy.composer.try}</span>
        {copy.suggestions.map((suggestion) => (
          <button
            type="button"
            class="rounded-full border border-white/70 bg-white/60 px-3 py-1 text-neutral-800 caption-4 backdrop-blur-md transition-[transform,background-color] duration-300 ease-out-quint hover:bg-white/90 active:scale-[0.98]"
            data-suggestion={suggestion.prompt}
          >
            {suggestion.label}
          </button>
        ))}
      </div>
    )
  }
</form>
