  "verification": {
    "requiredSelectors": [
      "[data-numa-ready='true']",
      "[data-numa-action='collect']",
      "[data-numa-action='engage']",
      "[data-numa-action='attack']",
      "[data-numa-action='reset']"
    ],
    "touchViewport": {
      "width": 390,
      "height": 844
    },
    "scenarios": [
      {
        "name": "initial-explore-state",
        "actions": [],
        "assertions": [
          {
            "path": "ready",
            "equals": true
          },
          {
            "path": "phase",
            "equals": "explore"
          },
          {
            "path": "crystalCount",
            "equals": 0
          },
          {
            "path": "enemyDefeated",
            "equals": false
          }
        ]
      },
      {
        "name": "collects-one-crystal",
        "actions": [
          {
            "type": "click",
            "selector": "[data-numa-action='collect']"
          }
        ],
        "assertions": [
          {
            "path": "crystalCount",
            "equals": 1
          },
          {
            "path": "lastAction",
            "equals": "collect"
          }
        ]
      },
      {
        "name": "engages-the-goblin",
        "actions": [
          {
            "type": "click",
            "selector": "[data-numa-action='engage']"
          }
        ],
        "assertions": [
          {
            "path": "phase",
            "equals": "encounter"
          },
          {
            "path": "lastAction",
            "equals": "engage"
          }
        ]
      },
      {
        "name": "attacks-to-victory",
        "actions": [
          {
            "type": "click",
            "selector": "[data-numa-action='attack']"
          }
        ],
        "assertions": [
          {
            "path": "phase",
            "equals": "victory"
          },
          {
            "path": "enemyDefeated",
            "equals": true
          },
          {
            "path": "lastAction",
            "equals": "attack"
          }
        ]
      },
      {
        "name": "reset-restores-explore-state",
        "actions": [
          {
            "type": "click",
            "selector": "[data-numa-action='reset']"
          }
        ],
        "assertions": [
          {
            "path": "phase",
            "equals": "explore"
          },
          {
            "path": "crystalCount",
            "equals": 0
          },
          {
            "path": "enemyDefeated",
            "equals": false
          },
          {
            "path": "resetCount",
            "equals": 1
          }
        ]
      }
    ]
  },
