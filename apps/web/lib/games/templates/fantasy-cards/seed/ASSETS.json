  "verification": {
    "requiredSelectors": [
      "[data-numa-ready='true']",
      "[data-numa-player-card]",
      "[data-numa-location]",
      "[data-numa-action='primary']",
      "[data-numa-action='end-turn']",
      "[data-numa-action='reset']"
    ],
    "touchViewport": { "width": 390, "height": 844 },
    "scenarios": [
      {
        "name": "initial-player-turn-is-safe",
        "actions": [],
        "assertions": [
          { "path": "ready", "equals": true },
          { "path": "phase", "equals": "player-turn" },
          { "path": "moveCount", "equals": 0 },
          { "path": "hiddenInformation.opponentMovesVisible", "equals": false }
        ]
      },
      {
        "name": "player-selects-card-and-location",
        "actions": [
          { "type": "click", "selector": "[data-numa-player-card]" },
          { "type": "click", "selector": "[data-numa-location]" }
        ],
        "assertions": [
          { "path": "selection.cardSelected", "equals": true },
          { "path": "selection.locationSelected", "equals": true }
        ]
      },
      {
        "name": "primary-action-commits-a-move",
        "actions": [
          { "type": "click", "selector": "[data-numa-action='primary']" }
        ],
        "assertions": [
          { "path": "lastAction", "equals": "primary" },
          { "path": "phase", "equals": "awaiting-end-turn" },
          { "path": "moveCount", "equals": 1 },
          { "path": "hiddenInformation.opponentMovesVisible", "equals": false }
        ]
      },
      {
        "name": "end-turn-changes-public-phase",
        "actions": [
          { "type": "click", "selector": "[data-numa-action='end-turn']" }
        ],
        "assertions": [
          { "path": "lastAction", "equals": "end-turn" },
          { "path": "phase", "equals": "opponent-turn" },
          { "path": "moveCount", "equals": 1 },
          { "path": "hiddenInformation.opponentMovesVisible", "equals": false }
        ]
      },
      {
        "name": "reset-restores-initial-public-state",
        "actions": [
          { "type": "click", "selector": "[data-numa-action='reset']" }
        ],
        "assertions": [
          { "path": "phase", "equals": "player-turn" },
          { "path": "moveCount", "equals": 0 },
          { "path": "resetCount", "equals": 1 },
          { "path": "hiddenInformation.opponentMovesVisible", "equals": false }
        ]
      }
    ]
  },
  "vendor": {
    "threeRevision": "r185",
    "commonRuntimeDependencies": [
      "vendor/three/addons/utils/BufferGeometryUtils.js"
    ]
  }
}
